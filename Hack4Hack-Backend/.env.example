# Application Runtime
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=https://hack4-hack-ps-02.vercel.app
CLIENT_URL_1=http://localhost:5173
CLIENT_URL_2=https://hack4-hack-ps-02.vercel.app

# Authentication & Sessions
COOKIE_SIGNER=replace_with_a_long_random_cookie_signer_secret_key_at_least_32_chars
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_at_least_32_chars

# Competition Deadline Rules
SUBMISSION_DEADLINE_ISO=2026-11-15T18:29:00.000Z
SUBMISSION_GRACE_PERIOD_SECONDS=300
MAX_SUBMISSION_SIZE_BYTES=104857600

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=hack4hack_db

# Redis Configuration (BullMQ, Sliding-Window Rate Limiter & Sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Object Storage (AWS S3 or MinIO)
AWS_REGION=ap-south-1
AWS_BUCKET=hack4hack-submissions-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Uncomment below for MinIO local storage:
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# Email Service (Resend)
RESEND_API_KEY=re_placeholder_for_resend_api_key
MAIL_FROM=Hack4Hack 2026 <submissions@hack4hack.io>

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
